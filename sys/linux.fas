const SYS_WRITE u64 = 1
const SYS_OPENAT u64 = 257
const SYS_READ u64 = 0
const SYS_CLOSE u64 = 3
const SYS_MMAP u64 = 9
const SYS_MUNMAP u64 = 11
const SYS_FSTAT u64 = 5

const EINTR i64 = 4
const EIO i64 = 5

const AT_FDCWD i32 = -100
const O_RDONLY i32 = 0

const PROT_READ i32 = 1
const PROT_WRITE i32 = 2

const MAP_PRIVATE i32 = 2
const MAP_ANONYMOUS i32 = 32

//
// syscalls
//

fn sys_openat(dirfd i32, path addr, flags i32, mode i32) i64 {
    return syscall(SYS_OPENAT, dirfd, path, flags, mode)
}

fn sys_read(fd i32, buffer addr, count usize) i64 {
    return syscall(SYS_READ, fd, buffer, count)
}

fn sys_close(fd i32) i64 {
    return syscall(SYS_CLOSE, fd)
}

fn free(p addr, size usize) i64 {
    return syscall(SYS_MUNMAP, p, size)
}

fn sys_fstat(fd i32, statbuf addr) i64 {
    return syscall(SYS_FSTAT, fd, statbuf)
}

//
// helpers
//

struct File {
    data addr
    len usize
    capacity usize
}

// TODO add proper error codes
fn read_file(out addr, path addr) i64 {

    fd i32 = trunc[i32](sys_openat(AT_FDCWD, path, O_RDONLY, 0))
    if fd < 0 { return fd }
    defer { sys_close(fd) }

    file_result i64 = get_file_size(fd)
    if file_result < 0 { return file_result }
    file_size usize = bitcast[usize](file_result)

    // file_size + 1 for empty files
    buffer addr = alloc(file_size + 1)
    if buffer == null { return -1 }

    total usize = 0

    while total < file_size {
        bytes_read i64 = sys_read(fd, buffer + total, file_size - total)

        if bytes_read == -EINTR { continue }
        if bytes_read < 0 {
            free(buffer, file_size + 1)
            return bytes_read
        }
        if bytes_read == 0 { break }

        total += bitcast[u64](bytes_read)
    }

    buffer[u8, total] = 0

    out[File].data = buffer
    out[File].len = total
    out[File].capacity = file_size + 1
    return 0
}

fn write_fd(fd i32, p addr, n usize) i64 {
    done usize = 0
    while done < n {
        r i64 = syscall(SYS_WRITE, fd, p + done, n - done)
        if r == -EINTR { continue }
        if r < 0 { return r }
        if r == 0 { return -EIO }
        done += bitcast[u64](r)
    }
    return bitcast[i64](done)
}

fn alloc(size usize) addr {
    if size == 0 { return null }

    r i64 = syscall(SYS_MMAP, 0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)
    if r < 0 { return null }

    return addr_from_bits(bitcast[usize](r))
}

fn get_file_size(fd i32) i64 {
    // stat struct -> https://github.com/torvalds/linux/blob/master/arch/x86/include/uapi/asm/stat.h
    statbuf arr[144, u8] = {}
    r i64 = sys_fstat(fd, &statbuf)
    if r < 0 { return r }
    // offset 48 is st_size
    return (&statbuf + 48)[i64, 0]
}

// write NUL terminated string
fn write_str(fd i32, str addr) i64 {
    n usize = 0
    while str[u8, n] != 0 { n += 1 }
    return write_fd(fd, str, n)
}

fn write_u64(fd i32, value u64) i64 {
    // biggest u64 number 18446744073709551615 is 20 digits
    digits arr[20, u8] = {}
    i usize = len(digits)
    while true {
        i -= 1
        digits[i] = trunc[u8](value % 10) + '0'
        value /= 10
        if value == 0 { break }
    }

    return write_fd(fd, &digits + i, len(digits) - i)
}
