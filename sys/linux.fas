const SYS_WRITE u64 = 1
const SYS_OPENAT u64 = 257
const SYS_READ u64 = 0
const SYS_CLOSE u64 = 3

const EINTR i64 = 4
const EIO i64 = 5

const AT_FDCWD i32 = -100
const O_RDONLY i32 = 0


fn write_fd(fd i32, p addr, n usize) i64 {
    done usize = 0
    while done < n {
        r i64 = syscall(SYS_WRITE, fd, p + done, n - done)
        if r == -EINTR { continue }
        if r < 0 { return r }
        if r == 0 { return -EIO }
        done += bitcast[u64](r)
    }
    return bitcast[i64](done)
}

fn sys_openat(dirfd i32, path addr, flags i32, mode i32) i64 {
    return syscall(SYS_OPENAT, dirfd, path, flags, mode)
}

fn sys_read(fd i32, buffer addr, count usize) i64 {
    return syscall(SYS_READ, fd, buffer, count)
}

fn sys_close(fd i32) i64 {
    return syscall(SYS_CLOSE, fd)
}
