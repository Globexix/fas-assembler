use linux "sys/linux.fas"

// token kind
// single characters like ";" are simply of its ascii value
const TOK_EOF u8 = 0
const TOK_IDENT u8 = 128
const TOK_NUMBER u8 = 129
const TOK_STRING u8 = 130

struct Token {
    kind u8
    start addr
    len usize
    line u32
}

struct Lexer {
    current addr
    end addr
    line u32
    column u32
}

fn main(argc i32, argv addr) i32 {
    if argc < 2 { return -1 }

    //
    // load source file from argv[1]
    //

    file File = {}

    if read_file(&file, argv[addr, 1]) < 0 { return -1 }
    defer { free(file.data, file.capacity) }
    write_str(1, c"file len: ")
    write_u64(1, file.len)
    write_str(1, c"\n")

    //
    // Lexer
    //
    lexer Lexer = {}

    lexer.current = file.data
    lexer.end = file.data + file.len
    lexer.line = 1

    token Token = {}

    while true {

        while lexer.current < lexer.end {
            ch u8 = lexer.current[u8]
            // skip comments
            if ch == '#' {
                while lexer.current < lexer.end && lexer.current[u8] != '\n' { continue }
            }
            // skip spaces
            if ch != ' ' && ch != '\t' && ch != '\r' { break }
            lexer.current += 1
        }

        token.start = lexer.current
        token.line = lexer.line
        token.kind = TOK_EOF

        if lexer.current < lexer.end {
             ch u8 = lexer.current[u8]
            lexer.current += 1
            // number
            if ch >= '0' && ch <= '9' {
                token.kind = TOK_NUMBER

                while lexer.current < lexer.end {
                    c u8 = lexer.current[u8]
                    if c < '0' || c > '9' { break }
                    lexer.current += 1
                }

            } else if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_' || ch == '.' {
                // identifiers
                token.kind = TOK_IDENT
                while lexer.current < lexer.end {
                    c u8 = lexer.current[u8]
                     letter bool = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '.'
                     if !letter && (c < '0' || c > '9') { break }
                     lexer.current += 1
                }
            } else {
                token.kind = ch
                if ch == '\n' { lexer.line += 1 }
            }
        }

        token.len = addr_bits(lexer.current) - addr_bits(token.start)
        write_u64(1, token.line)
        if token.kind == '\n' {
            write_str(1, c": newline\n")
        } else {
            write_str(1, c": kind ")
            write_u64(1, token.kind)
            write_str(1, c" '")
            write_fd(1, token.start, token.len)
            write_str(1, c"'\n")
        }

        if token.kind == TOK_EOF { break }
    }

    return 0
}
