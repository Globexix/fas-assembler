use linux "sys/linux.fas"

// token kind
// single characters like ";" are simply of its ascii value
const TOK_EOF u8 = 0
const TOK_IDENT u8 = 128
const TOK_NUMBER u8 = 129
const TOK_STRING u8 = 130

const BAD_NUMBER u32 = 0xFFFFFFFF

struct Token {
    kind u8
    start addr
    len usize
    line u32
}

struct Symbol {
    name addr
    name_len usize
    offset usize
    defined bool
}

struct Lexer {
    current addr
    end addr
    line u32
    column u32
}

struct Assembler {
    lexer Lexer
    token Token

    code addr
    code_len usize

    symbols addr
    symbol_count usize

    intel_syntax bool
}

//
// lexer
//

fn next_token(lex addr, tok addr) void {

    view lexer = lex[Lexer]
    view token = tok[Token]

    while lexer.current < lexer.end {
        ch u8 = lexer.current[u8]
        // skip comments
        if ch == '#' {
            while lexer.current < lexer.end && lexer.current[u8] != '\n' { lexer.current += 1 }
            continue
        }
        // skip spaces
        if ch != ' ' && ch != '\t' && ch != '\r' { break }
        lexer.current += 1
    }

    token.start = lexer.current
    token.line = lexer.line
    token.kind = TOK_EOF

    if lexer.current < lexer.end {
         ch u8 = lexer.current[u8]
        lexer.current += 1
        // number
        if ch >= '0' && ch <= '9' {
            token.kind = TOK_NUMBER

            while lexer.current < lexer.end {
                c u8 = lexer.current[u8]
                if c < '0' || c > '9' { break }
                lexer.current += 1
            }

        } else if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_' || ch == '.' {
            // identifiers
            token.kind = TOK_IDENT
            while lexer.current < lexer.end {
                c u8 = lexer.current[u8]
                 letter bool = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '.'
                 if !letter && (c < '0' || c > '9') { break }
                 lexer.current += 1
            }
        } else {
            token.kind = ch
            if ch == '\n' { lexer.line += 1 }
        }
    }

    token.len = addr_bits(lexer.current) - addr_bits(token.start)
}

//
// parser helper
//

fn same_bytes(a addr, b addr, n usize) bool {
    for i usize = 0; i < n; i += 1 {
       if a[u8, i] != b[u8, i] { return false }
    }
    return true
}

fn text_eq(str_a addr, str_b addr, n usize) bool {
    return same_bytes(str_a, str_b, n) && str_b[u8, n] == 0
}

fn at_statement_end(asm addr) bool {
    kind u8 = asm[Assembler].token.kind
    return kind == TOK_EOF || kind == '\n' || kind == ';'
}

fn accept_char(asm addr, ch u8) bool {
    if asm[Assembler].token.kind != ch { return false }
    next_token(&asm[Assembler].lexer, &asm[Assembler].token)
    return true
}

fn accept_word(asm addr, word addr) bool {
    view token = asm[Assembler].token

    if token.kind != TOK_IDENT || !text_eq(token.start, word, token.len) { return false }
    next_token(&asm[Assembler].lexer, &asm[Assembler].token)

    return true
}

// only 0..2147483647
fn parse_number(asm addr) u32 {
     view token = asm[Assembler].token
    if token.kind != TOK_NUMBER { return BAD_NUMBER }

    value u64 = 0
    for i usize = 0; i < token.len; i += 1 {
        value = value * 10 + zext[u64](token.start[u8, i] - '0')
        if value > 2147483647 { return BAD_NUMBER }
    }

    next_token(&asm[Assembler].lexer, &asm[Assembler].token)
    return trunc[u32](value)
}

//
// code emission
//
fn emit_byte(asm addr, byte u8) void {
    asm[Assembler].code[u8, asm[Assembler].code_len] = byte
    asm[Assembler].code_len += 1
}

fn emit_mov_rax(asm addr, imm u32) void {
    emit_byte(asm, 0x48) // REX.W
    emit_byte(asm, 0xC7) // mov r/m64, imm32
    emit_byte(asm, 0xC0) // ModRM
    (asm[Assembler].code + asm[Assembler].code_len)[u32] = imm // little endian
    asm[Assembler].code_len += 4
}

fn patch_rel32(asm addr, site usize, target usize) bool {
    delta i64 = bitcast[i64](target - (site + 4))
    if delta < -2147483648 || delta > 2147483647 { return false }
    (asm[Assembler].code + site)[i32] = trunc[i32](delta)
    return true
}

//
// symbols
//

// find symbol by name or ad as not defined
fn lookup_symbol(asm addr, name addr, name_len usize) addr {
    view a = asm[Assembler]

    for i usize = 0; i < a.symbol_count; i += 1 {
        symbol addr = a.symbols + i * sizeof[Symbol]
        if symbol[Symbol].name_len == name_len && same_bytes(symbol[Symbol].name, name, name_len) { return symbol }
    }

    slot addr = asm[Assembler].symbols + asm[Assembler].symbol_count * sizeof[Symbol]
    slot[Symbol].name = name
    slot[Symbol].name_len = name_len
    asm[Assembler].symbols += 1
    return slot
}

//
// statements
//

fn define_label(asm addr, name addr, name_len usize) bool {
    symbol addr = lookup_symbol(asm, name, name_len)

    if symbol[Symbol].defined { return false }
    symbol[Symbol].defined = true
    symbol[Symbol].offset = asm[Assembler].code_len

    return true
}

fn parse_jmp(asm addr) bool {
    view a = asm[Assembler]

    if a.token.kind != TOK_IDENT { return false }

    symbol addr = lookup_symbol(asm, a.token.start, a.token.len)
    next_token(&a.lexer, &a.token)

    if !at_statement_end(asm) { return false }
    if !symbol[Symbol].defined { return false }

    emit_byte(asm, 0xE9) // jmp rel32
    site usize = a.code_len
    a.code_len += 4

    return patch_rel32(asm, site, symbol[Symbol].offset)
}

fn parse_no_op(asm addr, opcode u8) bool {
    if !at_statement_end(asm) { return false }
    emit_byte(asm, opcode)
    return true
}

// mov $N, %rax
// AT&T: mov $N, %rax
// intel: mov rax, N
fn parse_mov(asm addr) bool {

    imm u32 = BAD_NUMBER
    if asm[Assembler].intel_syntax {
        if !accept_word(asm, c"rax") || !accept_char(asm, ',') { return false }
        imm = parse_number(asm)
    } else {
        if !accept_char(asm, '$') { return false }
        imm = parse_number(asm)
        if !accept_char(asm, ',') || !accept_char(asm, '%') || !accept_word(asm, c"rax") { return false }
    }

    if imm == BAD_NUMBER || !at_statement_end(asm) { return false }
    emit_mov_rax(asm, imm)

    return true
}

fn parse_syntax(asm addr, argument addr, intel bool) bool {
    if !accept_word(asm, argument) || !at_statement_end(asm) { return false }
    asm[Assembler].intel_syntax = intel
    return true
}

fn parse_intructions(asm addr, name addr, name_len usize) bool {
    if text_eq(name, c".intel_syntax", name_len) { return parse_syntax(asm, c"noprefix", true) }
    if text_eq(name, c".att_syntax", name_len) { return parse_syntax(asm, c"prefix", false) }
    if text_eq(name, c"mov", name_len) || text_eq(name, c"movq",name_len) { return parse_mov(asm) }
    if text_eq(name, c"jmp", name_len) { return parse_jmp(asm) }
    if text_eq(name, c"nop", name_len) { return parse_no_op(asm, 0x90) }
    if text_eq(name, c"ret", name_len) { return parse_no_op(asm, 0xC3) }

    return false
}

fn assemble(asm addr) bool {
    view a = asm[Assembler]

    next_token(&a.lexer, &a.token)
    while a.token.kind != TOK_EOF {
        // empty statement
        if at_statement_end(asm) { next_token(&a.lexer, &a.token); continue }

        if a.token.kind != TOK_IDENT { return false }
        name addr = a.token.start
        name_len usize = a.token.len
        next_token(&a.lexer, &a.token)

        if accept_char(asm, ':') {
            if !define_label(asm, name, name_len) { return false }
            continue
        }

        if !parse_intructions(asm, name, name_len) { return false }
    }

    return true
}

fn main(argc i32, argv addr) i32 {
    if argc < 2 { return -1 }

    //
    // load source file from argv[1]
    //

    file File = {}

    if read_file(&file, argv[addr, 1]) < 0 { return -1 }
    defer { free(file.data, file.capacity) }
    write_str(2, c"file len: ")
    write_u64(2, file.len)
    write_str(2, c"\n")

    code_size usize = file.len + 16
    code addr = alloc(code_size)

    if code == null { return -1 }
    defer { free(code, code_size) }

    symbols_size usize = (file.len / 2 + 1) * sizeof[Symbol]
    symbols addr = alloc(symbols_size)
    if symbols == null { return -1 }
    defer { free(symbols, symbols_size) }

    asm Assembler = {}
    asm.lexer.current = file.data
    asm.lexer.end = file.data + file.len
    asm.lexer.line = 1
    asm.code = code
    asm.symbols = symbols

    if !assemble(&asm) {
        write_str(2, c"line ")
        write_u64(2, asm.token.line)
        write_str(2, c": unsupported syntax\n")
        return -1
    }

    if write_fd(1, asm.code, asm.code_len) < 0 { return -1 }

    return 0
}
